[Unit]
Description=Personel Paneli (bagimsiz, tek dosya, Python standart kutuphanesi)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/personel-panel
EnvironmentFile=/etc/personel-panel.env
Environment=TZ=Europe/Istanbul
ExecStart=/usr/bin/python3 /opt/personel-panel/app.py
Restart=on-failure
RestartSec=3

# Guvenlik sertlestirmesi (istege bagli, ortam dosyasi bu dizinde okunmali)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/personel-panel

[Install]
WantedBy=multi-user.target
